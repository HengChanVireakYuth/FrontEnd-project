# Copy this file to .env.local and fill in your own values

# MongoDB Atlas connection string
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/jobdashboard?retryWrites=true&w=majority

# NextAuth secret - generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_this_with_a_random_string

# NextAuth URL (leave as-is for local dev)
NEXTAUTH_URL=http://localhost:3000
